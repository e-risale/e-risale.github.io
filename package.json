{
  "name": "sozler-kitabi",
  "version": "0.1.0",
  "description": "Risale-i Nur Translation Project",
  "author": "Risale Project Team",
  "private": true,
  "dependencies": {
    "firebase": "^12.7.0",
    "html2canvas": "^1.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "react-virtuoso": "^4.17.0",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "main": "public/electron.js",
  "homepage": "https://e-risale.github.io/",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "tasi": "node scripts/moveFiles.js",
    "electron:dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-is-dev": "^3.0.1",
    "gh-pages": "^6.3.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.risaleproject.sozler",
    "productName": "Sozler Kitabi",
    "files": [
      "build/**/*",
      "public/**/*"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}